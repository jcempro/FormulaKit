{
  "schema": "formulakit-build/v1",
  "package": "@jcempro/formulakit",
  "ecmascript": {
    "formula": "latest-published-edition-minus-2-years",
    "publishedEditions": [2020, 2021, 2022, 2023, 2024, 2025, 2026],
    "resolved": 2024
  },
  "formats": ["esm-js", "esm-mjs", "commonjs-cjs", "browser-esm"],
  "levels": ["basic", "advanced"],
  "scopes": [
    "math",
    "logic",
    "text",
    "statistics",
    "finance",
    "datetime",
    "collections",
    "validation",
    "conversion",
    "spreadsheet",
    "br"
  ],
  "combinations": {
    "data": ["collections", "conversion", "validation"],
    "business": ["finance", "datetime", "br"],
    "core": ["math", "logic", "text"]
  }
}
